APP_NAME="Expat Inclusion"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://api.expat-inclusion.test

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Base de données ───────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3307
DB_DATABASE=expat_inclusion
DB_USERNAME=root
DB_PASSWORD=

# ── Session / Cache / Queue ───────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.expat-inclusion.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail ──────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@expat-inclusion.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Stripe ────────────────────────────────────────────────────────
# Clé publique (dashboard Stripe > Développeurs > Clés API). Non utilisée
# aujourd'hui côté backend (Checkout hébergé, pas de Stripe Elements) —
# renseignée pour un futur besoin front.
STRIPE_KEY=
# Clé secrète — sk_test_... en développement, sk_live_... en production.
STRIPE_SECRET=
# Secret de signature du webhook. En local : `stripe listen --forward-to
# localhost:8000/api/stripe/webhook` affiche un whsec_... à coller ici.
# En production : dashboard Stripe > Webhooks > créer un endpoint.
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_AMOUNT=2000
STRIPE_CURRENCY=eur

# ── Firebase Admin ────────────────────────────────────────────────
# Chemin absolu vers le fichier service account JSON téléchargé depuis la console Firebase
# Ne jamais commiter ce fichier — il est dans .gitignore (firebase-service-account.json)
FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json

# ── Sanctum SPA ───────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=app.expat-inclusion.test,localhost:3000
FRONTEND_URL=http://app.expat-inclusion.test
