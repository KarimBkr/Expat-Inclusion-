rules_version = '2';

// Expat Inclusion — Security Rules Firestore (US-13)
// Collections autorisées : conversations, messages UNIQUEMENT.
// Accès limité aux participants d'une demande acceptée via claim
// `allowed_conversations` émis par Laravel (custom token).

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function canAccessConversation(conversationId) {
      return isSignedIn()
        && conversationId in request.auth.token.allowed_conversations;
    }

    function isParticipant(conversationId) {
      return canAccessConversation(conversationId)
        && request.auth.uid in resource.data.participant_ids;
    }

    // À utiliser dans les sous-collections : `resource` y désigne le document
    // enfant (message, read), pas la conversation — on relit la conversation
    // parente explicitement.
    function isParticipantOfParentConversation(conversationId) {
      return canAccessConversation(conversationId)
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participant_ids;
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant(conversationId);

      allow create: if canAccessConversation(conversationId)
        && request.auth.uid in request.resource.data.participant_ids
        && request.resource.data.participant_ids.size() == 2
        && request.resource.data.keys().hasAll([
          'booking_id',
          'participant_ids',
          'parent_id',
          'aesh_user_id'
        ]);

      allow update: if isParticipant(conversationId)
        && request.resource.data.participant_ids == resource.data.participant_ids
        && request.resource.data.booking_id == resource.data.booking_id;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipantOfParentConversation(conversationId);

        allow create: if isParticipantOfParentConversation(conversationId)
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.keys().hasAll(['sender_id', 'text', 'created_at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }

      // Marqueur de lecture par participant — un utilisateur ne peut écrire que son propre document.
      match /reads/{uid} {
        allow read: if isParticipantOfParentConversation(conversationId);

        allow write: if isParticipantOfParentConversation(conversationId) && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
