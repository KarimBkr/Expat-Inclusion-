rules_version = '2';

// Expat Inclusion — Security Rules Firestore (US-13)
// Collections autorisées : conversations, messages UNIQUEMENT.
//
// La création d'une conversation est interdite au client (`allow create: if
// false`) : seul Laravel en écrit le document, via l'API REST Firestore,
// après avoir vérifié dans MySQL que la demande a un jour été acceptée
// (`ConversationProvisioner`, appelé depuis `ConversationController::show`).
// Ces rules n'ont donc plus qu'à vérifier l'appartenance à `participant_ids`
// sur un document dont l'existence prouve déjà la légitimité — sans jamais
// transporter cette preuve dans un claim du token, qui grossirait sans limite
// avec le nombre de demandes acceptées et deviendrait périmé à chaque
// nouvelle acceptation survenue en cours de session.

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Ne prend pas conversationId : contrairement à la fonction suivante, elle
    // n'a pas besoin de reconstruire un chemin, `resource` désigne déjà le
    // document conversation à cet endroit de l'arbre.
    function isParticipant() {
      return isSignedIn()
        && request.auth.uid in resource.data.participant_ids;
    }

    // À utiliser dans les sous-collections : `resource` y désigne le document
    // enfant (message, read), pas la conversation — on relit la conversation
    // parente explicitement.
    function isParticipantOfParentConversation(conversationId) {
      return isSignedIn()
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participant_ids;
    }

    match /conversations/{conversationId} {
      allow read: if isParticipant();

      allow create: if false;

      allow update: if isParticipant()
        && request.resource.data.participant_ids == resource.data.participant_ids
        && request.resource.data.booking_id == resource.data.booking_id;

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipantOfParentConversation(conversationId);

        allow create: if isParticipantOfParentConversation(conversationId)
          && request.resource.data.sender_id == request.auth.uid
          && request.resource.data.keys().hasAll(['sender_id', 'text', 'created_at'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;

        allow update, delete: if false;
      }

      // Marqueur de lecture par participant — un utilisateur ne peut écrire que son propre document.
      match /reads/{uid} {
        allow read: if isParticipantOfParentConversation(conversationId);

        allow write: if isParticipantOfParentConversation(conversationId) && request.auth.uid == uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
